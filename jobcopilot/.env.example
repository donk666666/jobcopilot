# ============================================================
# JobCopilot 配置文件
# 复制此文件为 .env 并填入你自己的配置值
# ============================================================

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=jobcopilot

# ---- DeepSeek API（必填）----
# 如果使用中转站/代理（如 cloud.hongqiye.com）：
#   DEEPSEEK_API_KEY   = 中转站给你的 API Key
#   DEEPSEEK_BASE_URL  = 中转站地址
#   DEEPSEEK_MODEL     = 中转站支持的模型名（如 glm-5.2）
#
# 如果使用 DeepSeek 官方：
#   DEEPSEEK_API_KEY   = 你的 DeepSeek API Key
#   DEEPSEEK_BASE_URL  = https://api.deepseek.com/v1
#   DEEPSEEK_MODEL     = deepseek-chat
DEEPSEEK_API_KEY=sk-你的API密钥
DEEPSEEK_BASE_URL=https://你的中转站地址/v1
DEEPSEEK_MODEL=你的模型名

# ---- ChromaDB（可选）----
# CHROMA_DIR=./data/chroma_db

# ---- CORS（可选）----
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
